[Unit]
Description=GNOME Typer keyboard sounds
Documentation=https://github.com/dixonSolutions/gnome-typer
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service

[Service]
Type=simple
ExecStart=@BIN@
Restart=on-failure
RestartSec=2
# The daemon only ever reads input devices and writes audio.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=%h/.cache/gnome-typer

[Install]
WantedBy=default.target
